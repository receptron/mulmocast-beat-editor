{
  "name": "@mulmocast/beat-editor",
  "version": "1.1.1",
  "description": "Vue 3 components for editing MulmoScript beats live in the browser — every beat type renders as a div, and every editor is swappable",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/receptron/mulmocast-beat-editor.git"
  },
  "bugs": {
    "url": "https://github.com/receptron/mulmocast-beat-editor/issues"
  },
  "homepage": "https://github.com/receptron/mulmocast-beat-editor#readme",
  "keywords": [
    "mulmocast",
    "mulmoscript",
    "beat",
    "editor",
    "vue",
    "slide",
    "deck",
    "tailwind"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css"
  },
  "files": [
    "dist/lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "BUILD_TARGET=lib vue-tsc -b && BUILD_TARGET=lib vite build && yarn run build:css",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint src test --max-warnings 64",
    "test": "tsx --test ./test/**/test_*.ts",
    "knip": "knip",
    "format": "prettier --write '{src,test}/**/*.{ts,vue,css}'",
    "prepublishOnly": "yarn run build:lib",
    "build:css": "tsx scripts/collect_fragment_classes.ts && tailwindcss -i src/lib.css -o dist/lib/style.css --minify"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@mulmocast/deck": "^2.0.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mulmocast/deck": "^2.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "mulmocast": "^2.12.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "dompurify": "^3.4.14"
  }
}
